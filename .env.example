# ---------------------------------------------------------------------------
# Gmail / Google Cloud
# ---------------------------------------------------------------------------
# OAuth 2.0 client (type "Desktop app") created in Google Cloud Console →
# APIs & Services → Credentials. See README "Setup" step 3.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Refresh token for the Gmail account to triage. Obtain it with `npm run token`.
GOOGLE_REFRESH_TOKEN=
# Fully qualified Pub/Sub topic that Gmail publishes to (users.watch topicName):
#   projects/<gcp-project-id>/topics/<topic-name>
PUBSUB_TOPIC=
# Optional. If set, Pub/Sub notifications whose emailAddress does not match this
# address are acknowledged (HTTP 200) but not processed. Compared case-insensitively.
GMAIL_ADDRESS=

# ---------------------------------------------------------------------------
# Webhook / cron protection
# ---------------------------------------------------------------------------
# Random secret that must match the `?key=` query parameter on /api/gmail/notify.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=
# Random secret. Vercel sends it as `Authorization: Bearer <CRON_SECRET>` to cron
# routes. Must be named exactly CRON_SECRET for Vercel to pick it up.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# OpenRouter
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
# Primary model. Free tier: 20 requests/min, 50 requests/day (1000/day once $10
# of credits has ever been purchased).
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Comma-separated fallback models, tried in order when the primary fails.
OPENROUTER_FALLBACK_MODELS=xingchen-agi/xing4.0-29b-a4b:free,nvidia/nemotron-3-ultra-550b-a55b:free

# ---------------------------------------------------------------------------
# Labels (must already exist in Gmail; the agent never creates labels)
# ---------------------------------------------------------------------------
LABEL_IMPORTANT=Important Emails
LABEL_NEUTRAL=Neutral Emails
LABEL_JUNK=Junk Emails

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------
# Max emails classified per invocation. Keep below OpenRouter's 20 req/min free limit.
MAX_EMAILS_PER_RUN=15
# Only unread inbox mail newer than this many days is considered.
LOOKBACK_DAYS=7
# Email body is truncated to this many characters before classification.
BODY_MAX_CHARS=4000
